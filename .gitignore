# ---------------------------------------------------------------------------
# SyncClass — version control exclusions
# ---------------------------------------------------------------------------

# Composer dependencies (installed with `composer install`)
/vendor/

# Local configuration and secrets — never commit these
/config/local.php
/.env
/.env.*
!.env.example

# Runtime output
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/exports/*
!/storage/exports/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/public/assets/uploads/*
!/public/assets/uploads/.gitkeep
!/public/assets/uploads/.htaccess

# Local release/build archives — never part of the repository
*.zip
*.7z

# Ad-hoc verification output
/.tmp-verify/

# Tooling artefacts
composer.phar
*.log
.phpunit.result.cache
.DS_Store
Thumbs.db
/.idea/
/.vscode/
