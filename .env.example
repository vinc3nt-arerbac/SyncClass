# ---------------------------------------------------------------------------
# SyncClass — environment template
#
# Copy to `.env` (git-ignored) and edit. bootstrap.php exports these values
# before config/*.php is read, so a `.env` next to this file is enough on
# XAMPP; you can also set real environment variables or use
# config/local.php instead. Real environment variables always win over .env.
#
# Never commit `.env`. It contains the database password.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=SyncClass
APP_INSTITUTION="Santa Ana College"
APP_ENV=production
APP_DEBUG=false
# No trailing slash. This is the URL Apache serves the project from.
APP_URL=http://localhost/syncclass
APP_TIMEZONE=Asia/Manila
# Set to true only when the site is served over HTTPS (marks the session
# cookie Secure).
APP_HTTPS=false

# --- Database --------------------------------------------------------------
# XAMPP defaults: MySQL/MariaDB on 127.0.0.1:3306, user root, empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anth04_SyncClass
DB_USERNAME=root
DB_PASSWORD=

# --- Mail (optional) -------------------------------------------------------
# In-app notifications work without SMTP. Set MAIL_ENABLED=true and fill in a
# real host to also send email; php bin/dispatch-notifications.php reads these.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sac.edu.ph
MAIL_FROM_NAME=SyncClass
